{
  "pluginAlias": "HomebridgeAutomations",
  "pluginType": "platform",
  "singular": true,
  "strictValidation": true,
  "schema": {
    "type": "object",
    "$defs": {
      "accessory": {
        "type": "object",
        "properties": {
          "accessoryName": {
            "title": "Accessory Name",
            "type": "string",
            "placeholder": "Porch Light"
          },
          "accessoryType": {
            "title": "Accessory Type",
            "type": "string",
            "oneOf": [
              { "title": "Light", "enum": ["light"] },
              { "title": "Outlet", "enum": ["outlet"] },
              { "title": "Switch", "enum": ["switch"] }
            ]
          },
          "property": {
            "title": "Property",
            "type": "string",
            "oneOf": [
              { "title": "Power", "enum": ["power"] },
              { "title": "Mute", "enum": ["mute"] }
            ]
          },
          "value": {
            "title": "Value",
            "type": "string",
            "oneOf": [
              { "title": "On", "enum": ["on"] },
              { "title": "Off", "enum": ["off"] }
            ]
          }
        }
      },
      "time": {
        "type": "object",
        "properties": {
          "hour": {
            "title": "Hour *",
            "type": "integer",
            "minimum": 0,
            "maximum": 23
          },
          "minutes": {
            "title": "Minutes *",
            "type": "integer",
            "minimum": 0,
            "maximum": 59
          }
        }
      }
    },
    "properties": {
      "name": {
        "title": "Platform Name",
        "type": "string",
        "required": true,
        "default": "Homebridge Automations",
        "readonly": true
      },
      "automations": {
        "title": "Automations",
        "type": "array",
        "orderable": true,
        "items": {
          "title": " {{ value.automationName || 'New Automation' }}",
          "type": "object",
          "expandable": true,
          "expanded": false,
          "uniqueItemProperties": [ "automationName" ],
          "properties": {
            "automationName": {
              "title": "Automation Name",
              "type": "string",
              "required": true
            },
            "trigger": {
              "title": "Trigger",
              "type": "object",
              "expandable": true,
              "expanded": false,
              "properties": {
                "event": {
                  "title": "Event *",
                  "type": "string",
                  "oneOf": [
                    { "title": "A Time of Day Occurs", "enum": ["timeevent"] },
                    { "title": "An Accessory is Controlled", "enum": ["accessoryevent"] },
                    { "title": "A Sensor Detects Something", "enum": ["sensorevent"] }
                  ]
                },
                "timeEvent": {
                  "title": " ",
                  "type": "object",
                  "properties": {
                    "when": {
                      "title": "When *",
                      "type": "string",
                      "oneOf": [
                        { "title": "Sunset", "enum": ["sunset"] },
                        { "title": "Sunrise", "enum": ["sunrise"] },
                        { "title": "Time of Day", "enum": ["timeofday"] }
                      ]
                    },
                    "time": {
                      "title": " ",
                      "type": "object",
                      "properties": {
                        "$ref": "#/$defs/time/properties"
                      },
                      "condition": {
                        "functionBody": "return model.automations[arrayIndices].trigger.timeEvent.when === 'timeofday';"
                      }
                    },
                    "repeat": {
                      "title": "Repeat *",
                      "type": "array",
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "title": "Option",
                        "enum": [
                          "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"
                        ]
                      }
                    }
                  },
                  "condition": {
                    "functionBody": "return model.automations && model.automations[arrayIndices].trigger.event === 'timeevent';"
                  },
                  "allOf": [
                    {
                      "if": {
                        "required": [ "when" ],
                        "properties": {
                          "when": { "const": "timeofday" }
                        }
                      },
                      "then": {
                        "required": [ "time" ],
                        "properties": {
                          "time": {
                            "required": [ "hour", "minutes" ]
                          }
                        }
                      }
                    }
                  ]
                }
              },
              "allOf": [
                {
                  "if": {
                    "required": [ "event" ],
                    "properties": {
                      "event": { "const": "timeevent" }
                    }
                  },
                  "then": {
                    "required": [ "timeEvent" ],
                    "properties": {
                      "timeEvent": {
                        "required": [ "when", "repeat" ]
                      }
                    }
                  }
                }
              ]
            },
            "actions": {
              "title": "Actions",
              "type": "object",
              "expandable": true,
              "expanded": false,
              "properties": {
                "$ref": "#/$defs/accessory/properties"
              }
            },
            "conditions": {
              "title": "Conditions",
              "type": "object",
              "expandable": true,
              "expanded": false,
              "properties": {
                "type": {
                  "title": "Type",
                  "type": "string",
                  "oneOf": [
                    { "title": "Time", "enum": ["time"] },
                    { "title": "Accessory", "enum": ["accesswory"] },
                    { "title": "Sensor", "enum": ["sensor"] }
                  ]
                }
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "automationName": { "minLength": 1 }
                }
              },
              "then": {
                "required": [ "trigger" ],
                "properties": {
                  "trigger": {
                    "required": [ "event" ]
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
}
